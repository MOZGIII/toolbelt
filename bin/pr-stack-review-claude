#!/usr/bin/env bash
#
# pr-stack-review-claude — run a Claude Code review over one PR branch, or
# over every branch a remap file lists, one branch at a time.
#
# The script owns the git worktree it runs in: it checks out each branch under
# review, so anything else you are doing must happen in another worktree. The
# original branch is restored when the run finishes (--no-restore to stay on
# the last reviewed branch).
#
# A branch needs no PR to be reviewed. The reviewer works from branches alone
# — it never learns a PR number — so a stack can be reviewed, fixed and
# reviewed again before any of it is opened on GitHub. There is one branch per
# PR, and the merge gate finds a PR's review through its branch, so what was
# reviewed here before the PR existed counts once it does.
#
# What a branch is reviewed *against* is its parent in the stack, not the
# base: in a chained stack every PR sits on the previous PR's branch, so
# reviewing against the base would re-review everything underneath it. With a
# remap file (--remap-file, the file `pr-stack remap` reads) the parent is
# derived from git, never from the order of the file's lines: a branch's
# parent is the listed branch whose tip is its nearest ancestor — or the base
# (--base) when nothing listed lies below it. Entries commented out as merged
# are not read: what has landed is in the base by then.
#
# A stack that was rebased and not remapped must not be reviewed: its
# branches still hold what they held before the rebase, so a review of them
# is a review of code that is no longer the stack. A remap file therefore
# comes with its stack head (--stack), and the run refuses to start unless
# every listed branch sits on the commit its pattern matches in
# <base>..<stack head> — the same rule as `pr-stack remap --check`. The stack
# head is always passed, never taken from the branch that happens to be
# checked out: what is reviewed, and against what, does not depend on where
# the run was started from. --no-remap-check is the explicit way out of the
# check: the listed branches are reviewed where they are, and the patterns
# are not read at all. One of the two has to be passed with a remap file.
#
# Without a remap file, `review` takes the branch as the whole stack and
# reviews it against --base. That is the same review in every other respect —
# same directory, same run files, same standing with the merge gate — only
# the parent is given rather than derived.
#
# Each branch gets a directory under the output directory, called after the
# branch with "/" turned into "-". Inside it, every review is a numbered run
# of its own — nothing is ever overwritten, so a re-review can be read against
# the one it supersedes — with a "latest" symlink onto the newest:
#
#   .reviews/mzg-2026-07-23-transient-bringup-refactor/
#       001/ …          first review
#       002/ …          re-review, e.g. after a push or a prompt change
#       latest -> 002
#
# What a branch holds is not fixed. Between two runs it may have been split
# in two, reordered, or joined with another branch, so the runs under one
# directory are not assumed to cover the same commits, and a re-review
# reviews whatever the branch is now against whatever its parent is now. What
# a given run covered is in its "range" file.
#
# The symlink moves when a run starts rather than when it finishes, so
# latest/output.jsonl can be tailed live. Each run directory holds these
# fixed-name files:
#
#   range        what this run covered: the base it was reviewed against (the
#                ref and its commit) on the first line, then every commit
#                under review, one "<hash>  <subject>" per line, oldest
#                first. Written when the run starts. Nothing reads it back:
#                it is there so a round can be matched to the change it was
#                about after the branch has moved on;
#   output.jsonl the full conversation as stream-json: one event per thinking
#                block, tool call, tool result, and the closing usage tally —
#                the record of how the review reached its conclusion;
#   debug.log    Claude Code's own instrumentation — settings and plugin
#                loading, API requests and their timing, hook firing. Disjoint
#                from output.jsonl: it holds none of the conversation, and the
#                transcript holds none of the internals;
#   review.md    the review itself — Claude writes this file, the prompt tells
#                it where;
#   verdict      a machine-readable "true" or "false": is this PR ready to
#                merge. Also written by Claude, also per the prompt;
#   session-id   the Claude Code session this run used, so an interrupted run
#                can be continued rather than repeated (see --resume).
#
# The latest run's verdict file doubles as the completion marker: a branch
# whose newest run decided something is skipped unless --force is given, so a
# review-all run that dies halfway resumes where it stopped, and --force
# means "review it again into a new run", never "overwrite what is there".
#
# The prompt is a template file (default: share/prompts/code-review.md under
# this script's prefix — bin/ and share/ are siblings, in the repo as much as
# in an install tree) with these placeholders substituted before the run:
#
#   {{BRANCH}}       branch under review
#   {{BASE}}         branch it is reviewed against (its parent in the stack)
#   {{RANGE}}        "<base>..<branch>", ready for git log / git diff
#   {{TITLE}}        subject of the branch's tip commit
#   {{REPO_ROOT}}    absolute path of the worktree
#   {{REVIEW_FILE}}  absolute path the review must be written to
#   {{VERDICT_FILE}} absolute path the verdict must be written to
#
# Subcommands:
#
#   review [options] [-m|--remap-file <file>
#          (--stack <branch> | --no-remap-check)] [--base <ref>] <branch>
#       Review one branch against its parent. With a remap file the branch
#       must be listed in it, and its parent is derived as described above;
#       without one the branch is reviewed against --base directly.
#
#   review-all [options] -m|--remap-file <file>
#              (--stack <branch> | --no-remap-check) [--base <ref>]
#       Review every entry in the remap file, bottom of the stack first,
#       skipping the ones already reviewed. Stops at the first failure unless
#       --keep-going.
#       With --failed the selection flips: instead of the entries not yet
#       reviewed, take the ones whose latest verdict came back "false" — the
#       rejections, to be re-reviewed once the code is fixed. Only a decided
#       "false" qualifies: errored, malformed and unfinished runs are pending,
#       not rejected, and the ordinary selection is what retries those.
#       The train is a named walk that survives being stopped: what it has
#       passed is recorded under --progress-track <name>, and a re-run under
#       the same name carries on from the entry it was on (see "Walks"
#       below). The name is required; --no-progress-track runs the train
#       without a walk, resumable by verdicts alone.
#
#   status [--output-dir <dir>] -m|--remap-file <file>
#       Show which remap-file entries have been reviewed and what they came
#       back with, in the file's own order. Moves no branch and runs no
#       Claude.
#
# Remap file format is pr-stack's (lib/remap.sh): "<branch>  <commit message
# substring>", one per line, "#" starting a comment.
#
# Walks (review-all --progress-track <name>):
#
# Verdicts alone cannot resume every train. A --force train re-reviews decided
# entries, so a re-run cannot tell the ones this train already redid from the
# ones it has not reached; a --failed train re-reviews rejections, and one that
# came back "false" again looks exactly like one not yet retried. A walk
# records what the train itself has passed, under a name, so a re-run with the
# same name continues from where the previous run stopped whatever the passed
# entries decided:
#
#   .reviews/walks/<name>
#       # header comments: the remap file the walk runs over, when it started
#       <state>  <branch>                    one line per entry reached
#
# The state is "running" while the entry's review is in flight and becomes its
# verdict ("true" / "false") when the review decides, or "failed" when the
# review errored and --keep-going moved the train past it. The file is
# rewritten whole at each of those transitions.
#
# On a re-run the flags still say which entries the train visits (the ordinary
# selection, --failed, or --force); the walk then overrides per entry: a
# concluded state is skipped regardless of what it concluded, and "running" is
# taken whatever the flags say — an unfinished run has no verdict, so --failed
# alone would drop the very entry the walk was on — and picks its Claude Code
# session up the way --resume does, --force notwithstanding. A "running" entry
# whose newest run already holds a verdict (the stop landed as the verdict was
# being written) is recorded with that verdict and skipped, never reviewed
# twice. A review that errors without --keep-going stops the train and stays
# "running", so the re-run retries exactly there.
#
# A finished walk keeps its file as the record; a re-run under its name finds
# nothing left. A new walk is a new name, or the old file deleted. --dry-run
# reads a walk but never writes one. The merge gate never reads walks: they
# are the reviewer's own bookkeeping, and "hold" files remain the only gate
# beside the verdicts.
#
# Systemd scope:
#
# claude runs inside a transient systemd user scope (systemd-run --user
# --scope), stopped as soon as the review pipeline returns. A scope is a
# cgroup holding claude and every process it ever forks, including the ones a
# tool shell backgrounded and left behind: those are reparented to init when
# the shell ends, so nothing that only signals claude — the timeout, Ctrl-C,
# claude's own shutdown — reaches them, and a busy loop a review started to
# stress a timing assertion runs until someone notices the load. Stopping the
# scope kills the whole cgroup. It has to be stopped explicitly: a scope lives
# while any process in it does, which is exactly the leftover case. The scope
# is entered by exec, so claude keeps the pid the timeout and the terminal
# signal, and its exit status passes through unchanged. --no-systemd-scope
# runs claude as a plain child, for hosts without a user manager. A scope left
# by a run that was itself killed outright is listed by
# `systemctl --user list-units 'pr-stack-review-*'` and stopped by hand.
#
set -euo pipefail

# resolve_self <path>
#
# Absolute path to <path>, symlinks resolved where the system can do it:
# `readlink -f` is GNU coreutils, so it is absent on macOS and on minimal
# images. The fallback leaves symlinks unresolved, which is right in every case
# but the one readlink was there for — a bin entry symlinked onto PATH, whose
# siblings and assets then have to be looked for beside the symlink instead.
resolve_self() {
	local path="$1" resolved
	if resolved="$(readlink -f "$path" 2>/dev/null)" && [[ -n "$resolved" ]]; then
		printf '%s' "$resolved"
	else
		printf '%s/%s' "$(cd "$(dirname "$path")" && pwd)" "$(basename "$path")"
	fi
}

# bin/, lib/ and share/ are siblings under a prefix, which the repo itself
# mirrors, so this resolves the same way in a checkout as under an install tree.
BIN_DIR="$(dirname "$(resolve_self "${BASH_SOURCE[0]}")")"
PREFIX="$(dirname "$BIN_DIR")"
PROMPT_FILE_DEFAULT="$PREFIX/share/prompts/code-review.md"

# Reviews run unattended, so nothing may take over the terminal or wait for
# input; common.sh drops colour when stdout is redirected so logs stay clean.
# die() is itself in common.sh, so failing to load it cannot be reported with it.
for module in common remap review; do
	# shellcheck source=/dev/null
	. "$PREFIX/lib/$module.sh" || {
		printf 'error: cannot load %s\n' "$PREFIX/lib/$module.sh" >&2
		exit 1
	}
done

require_tools() {
	command -v claude >/dev/null || die "claude (Claude Code CLI) is required but not on PATH"
	command -v git >/dev/null || die "git is required but not on PATH"
	# jq only renders the live view; the transcript is captured either way.
	command -v jq >/dev/null ||
		printf 'note: jq is not on PATH — reviews still run, but there is no live progress to watch\n' >&2
}

# require_model
#
# Every review command runs this before it touches the worktree. There is no
# default model on purpose: a review is judged with the model in mind, so the
# choice is made per run rather than inherited from whatever this script last
# shipped with.
require_model() {
	[[ "$MODEL_SET" -eq 1 ]] ||
		die "--model is required; pass an empty string to leave the model to claude"
}

# ---------------------------------------------------------------------------
# Systemd scope (see the header)
# ---------------------------------------------------------------------------

# require_systemd_scope
#
# Every review command runs this before it touches the worktree, unless
# --no-systemd-scope was given: a run that finds out at its first review that
# no user manager answers has already checked a branch out for nothing.
# Starting a scope is the only honest probe — the manager can be running and
# still out of reach from a session that has no bus to it.
require_systemd_scope() {
	[[ "$SYSTEMD_SCOPE" -eq 1 ]] || return 0
	systemd-run --user --scope --quiet --collect \
		--unit="pr-stack-review-probe-$$-$RANDOM.scope" -- true ||
		die "cannot start a systemd user scope (see above); --no-systemd-scope runs claude without one"
}

# scope_unit_name
#
# Unique per run: a resumed session is a new process and gets a new scope, and
# a unit a live scope still holds would refuse to start. The branch is not in
# it, since "/" is not a unit-name character.
scope_unit_name() {
	printf 'pr-stack-review-%s-%s.scope' "$$" "$RANDOM"
}

# stop_scope <unit>
#
# Ends the systemd scope claude ran in and every process still in it. Runs on every path
# out of the pipeline: normal exit, error, timeout and interrupt alike. Counts
# what it is about to kill first, so a review that left work behind says so
# in its log rather than in the load average; the count is best effort (it
# reads the unified cgroup tree) and the stop does not depend on it. A scope
# whose last process has already exited is gone by now (--collect), and
# stopping it is an error that means nothing.
stop_scope() {
	local unit="$1" cgroup=""
	local -a leftovers=()
	cgroup="$(systemctl --user show --property=ControlGroup --value "$unit" 2>/dev/null)" || cgroup=""
	[[ -z "$cgroup" || ! -r "/sys/fs/cgroup$cgroup/cgroup.procs" ]] ||
		mapfile -t leftovers <"/sys/fs/cgroup$cgroup/cgroup.procs"
	systemctl --user stop "$unit" >/dev/null 2>&1 || true
	[[ ${#leftovers[@]} -eq 0 ]] ||
		note "reaped ${#leftovers[@]} process(es) the reviewer left behind"
}

usage() {
	cat >&2 <<'EOF'
Usage: pr-stack-review-claude <command> [options] [args]

Commands:
  review [options] [-m|--remap-file <file>
         (--stack <branch> | --no-remap-check)] [--base <ref>] <branch>
        Review one branch against its parent. The branch needs no PR: a
        review is filed under the branch, and the merge gate finds it
        there once a PR exists.
        With --remap-file the branch must be listed in the file, and its
        parent is the listed branch whose tip is its nearest ancestor
        (the base when none lies below it). Without it the branch
        is reviewed against --base directly. Either way it is the same
        review, filed in the same place.

  review-all [options] -m|--remap-file <file>
             (--stack <branch> | --no-remap-check) [--base <ref>]
             [--failed] [--max <n>] [--keep-going]
             (--progress-track <name> | --no-progress-track)
        Review every not-yet-reviewed entry in the remap file, bottom of
        the stack first. Stops at the first failure so nothing is silently
        skipped; --keep-going records the failure and carries on. Re-run
        to resume.
        Ctrl-C stops the train, --keep-going or not, once the running
        review has shut down; that review is left resumable (see --resume).
        A branch whose verdict file is missing or unreadable counts as
        not reviewed, so a run that went wrong is retried rather than
        quietly accepted.
        --failed flips the selection: take the entries whose latest verdict
        is "false" instead — the rejections, for re-review once the code is
        fixed. Only a decided "false" qualifies; errored and unfinished
        runs are pending, which the ordinary selection retries. Each
        re-review is a fresh numbered run beside the one it answers.
        Refuses --force, which redoes decided entries regardless of their
        verdict: to redo passed reviews too, drop --failed.
        --progress-track <name> makes the train a walk that survives being
        stopped: every entry it passes is recorded in
        <output-dir>/walks/<name> with what it concluded, and a re-run
        under the same name skips those whatever they concluded, resumes
        the review that was in flight (its Claude Code session, as with
        --resume — --force does not override this), and goes on with the
        rest of the selection. --force and --failed keep their meaning for
        the entries the walk has not reached. A finished walk stays on
        disk; start another under a new name, or delete the file.
        The name is required: a train that forgot it finds out when it is
        stopped, which is too late. --no-progress-track runs the train
        without a walk, resumable by verdicts alone; passing both is an
        error.

  status [--output-dir <dir>] -m|--remap-file <file>
        Print each remap-file entry with its review state and verdict.

Options (all review commands):
  -m, --remap-file <file>
                       the remap file listing the stack's branches, as
                       `pr-stack remap` reads it ("<branch>  <commit message
                       substring>" per line). Required by review-all and
                       status, optional for review. With review and
                       review-all it takes one of --stack and
                       --no-remap-check alongside it
  --base <ref>         what the bottom of the stack is reviewed against
                       (default: main): with a remap file, the branches
                       with no listed branch below them; without one, the
                       branch given to review
  --stack <branch>     the stack head the remap file is checked against:
                       every listed branch must sit on the commit its
                       pattern matches in <base>..<branch>, as
                       `pr-stack remap --check` verifies, or the run
                       refuses to start — a stack that was rebased and
                       not remapped is not reviewed. There is no default:
                       the branch checked out when the run starts plays
                       no part in what is reviewed. Only with --remap-file
  --no-remap-check     review the remap file's branches where they are,
                       without that check; the patterns are not read.
                       Only with --remap-file, and not together with
                       --stack
  --output-dir <dir>   where the per-branch review directories go
                       (default: <repo-root>/.reviews). Each holds one
                       numbered directory per run (001, 002, …) plus a
                       "latest" symlink; a run holds range, output.jsonl,
                       debug.log, review.md and verdict.
  --prompt-file <path> prompt template (default: share/prompts/code-review.md
                       under this script's prefix)
  --model <name>       passed to claude --model; required, there is no
                       default. Pass an empty string to leave the model
                       unset and take whatever claude defaults to
  --effort <level>     passed to claude --effort
  --permission-mode <mode>
                       passed to claude --permission-mode
                       (default: acceptEdits)
  --allow <tool-spec>  replace the default tool allowlist; repeatable, so
                       --allow Read --allow "Bash(git *)" gives exactly those
                       two. Default: Read Bash Write Edit Skill ReportFindings
                       TodoWrite ToolSearch Task Agent TaskOutput TaskStop —
                       enough to search the tree, run the code-review skill,
                       fan verification out to subagents (listed under both
                       of the names that tool answers to) and write the two
                       output files; no network tools. Narrow it only for a
                       prompt you know needs
                       less: an unattended run cannot answer a permission
                       prompt, so anything left out is silently denied and
                       the review comes back hollow but still confident.
  --no-tool-limits     do not pass --allowed-tools at all; whatever the
                       permission mode allows is allowed.
  --timeout <seconds>  abort a single review after this long (0: no limit)
  --systemd-scope      run claude in a transient systemd user scope and stop
                       the scope once claude has exited, so a process a tool
                       shell backgrounded and forgot dies with the review
                       instead of outliving it (default; needs a systemd
                       user manager reachable from this session)
  --no-systemd-scope   run claude as a plain child. Whatever a review leaves
                       behind then survives it until someone finds it
  --force              re-review branches whose latest run already decided,
                       as a new numbered run beside the old one
  --resume             continue an interrupted run instead of starting over:
                       when a branch's newest run began its session but
                       never reached a verdict, pick that Claude Code session
                       up where it stopped, in the same run directory, with
                       the transcript appended. Runs that finished are not
                       resumable, and neither is one stopped before its
                       session began: that one is started over as a fresh
                       run. --force wins if both are given.
  --no-restore         stay on the last reviewed branch instead of going
                       back to the branch that was checked out at the start
  --dry-run            print what would be reviewed against what, and the
                       rendered prompt; run nothing

The worktree must have no modified tracked files: the script checks branches
out. Untracked files are fine, which is why the default output directory can
live inside the repo.
EOF
	exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# The stack
#
# The remap file's format and the matching of its patterns to commits live in
# lib/remap.sh, shared with pr-stack. What is local to reviewing is the
# reading of the listed branches as a stack — which branch lies below which —
# and the check that the stack is where the remap file says it is.
# ---------------------------------------------------------------------------

# The remap file's branches in stack order, bottom first, parallel to each
# other: the branch, the branch it is reviewed against, and the subject of its
# tip commit. Filled by load_stack.
STACK_BRANCHES=()
STACK_PARENTS=()
STACK_TITLES=()

# check_remap <remap-file> <base> <stack-head>
#
# The `pr-stack remap --check` rule, over the remap file parse_remap_file has
# just read: every pattern matches one commit in <base>..<stack-head>, and
# every listed branch sits on its matched commit. Dies otherwise.
#
# This is what keeps a stack that was rebased and not remapped from being
# reviewed. The review checks each branch out, so a branch the rebase left
# behind would be reviewed as the commits it used to hold. Moving branches is
# pr-stack's job, not this script's, so this stops and says which ones are
# off. It needs the stack head for that — the listed branches cannot say on
# their own whether the stack has moved on without them — which is why --stack
# is asked for rather than guessed.
check_remap() {
	local remap_file="$1" base="$2" head="$3"
	git rev-parse --verify --quiet "$head^{commit}" >/dev/null ||
		die "stack head does not resolve: $head"

	resolve_remap_commits "$base" "$head" ||
		die "$remap_file does not match $base..$head (see above); nothing is reviewed"

	local -a stale=()
	local i branch
	for i in "${!REMAP_BRANCHES[@]}"; do
		branch="${REMAP_BRANCHES[$i]}"
		if ! git show-ref --verify --quiet "refs/heads/$branch"; then
			stale+=("$branch: missing locally, expected ${REMAP_HASHES[$i]:0:12}")
		elif [[ "$(git rev-parse "refs/heads/$branch")" != "${REMAP_HASHES[$i]}" ]]; then
			stale+=("$branch: at $(git rev-parse --short=12 "refs/heads/$branch"), expected ${REMAP_HASHES[$i]:0:12}  (${REMAP_SUBJECTS[$i]})")
		fi
	done
	if [[ ${#stale[@]} -gt 0 ]]; then
		printf 'error: %d branch(es) of %s are not on their matched commits in %s:\n' \
			"${#stale[@]}" "$remap_file" "$base..$head" >&2
		printf '         %s\n' "${stale[@]}" >&2
		die "nothing is reviewed until they are (pr-stack remap moves them; --no-remap-check reviews them where they are)"
	fi
}

# load_stack <remap-file> <base> <stack-head>
#
# Reads the remap file's branches as a stack. With a <stack-head> the remap
# check runs first (check_remap); an empty one is --no-remap-check, and the
# patterns are then never read.
#
# The stack itself comes from the branches' own tips, the same way with the
# check and without it: an entry's parent is the listed branch whose tip is
# its nearest strict ancestor, or <base> when no listed branch lies below it,
# and the entries are ordered bottom first by how many commits each has on top
# of <base>. Neither depends on the order of the file's lines, on a stack
# head, or on the branch checked out when the run started. Two branches listed
# on one commit share a parent and neither is the other's.
#
# Every listed branch has to exist and hold commits on top of <base>: one
# that does not has nothing to review, and finding that out here costs less
# than finding it out halfway through a train.
#
# A branch listed twice is one entry: there is one review per branch.
load_stack() {
	local remap_file="$1" base="$2" head="$3"
	git rev-parse --verify --quiet "$base^{commit}" >/dev/null ||
		die "base ref does not resolve: $base"

	parse_remap_file "$remap_file"
	[[ -z "$head" ]] || check_remap "$remap_file" "$base" "$head"

	local -A seen=()
	local -a branches=() unusable=()
	local i branch base_commit
	base_commit="$(git rev-parse --verify "$base^{commit}")"
	for i in "${!REMAP_BRANCHES[@]}"; do
		branch="${REMAP_BRANCHES[$i]}"
		[[ -z "${seen[$branch]:-}" ]] || continue
		seen["$branch"]=1
		if ! git show-ref --verify --quiet "refs/heads/$branch"; then
			unusable+=("$branch: missing locally")
		elif ! git merge-base --is-ancestor "$base_commit" "refs/heads/$branch"; then
			unusable+=("$branch: does not sit on top of $base")
		elif [[ "$(git rev-parse "refs/heads/$branch")" == "$base_commit" ]]; then
			unusable+=("$branch: has no commits on top of $base")
		else
			branches+=("$branch")
		fi
	done
	if [[ ${#unusable[@]} -gt 0 ]]; then
		printf 'error: %d branch(es) of %s cannot be reviewed against %s:\n' \
			"${#unusable[@]}" "$remap_file" "$base" >&2
		printf '         %s\n' "${unusable[@]}" >&2
		die "nothing is reviewed: every listed branch has to exist and hold commits on top of $base"
	fi

	# "<commits on top of base> <index>" per branch, sorted bottom first;
	# branches the same distance up keep the order the file lists them in.
	local order=""
	for i in "${!branches[@]}"; do
		order+="$(git rev-list --count "$base_commit..refs/heads/${branches[$i]}") $i"$'\n'
	done

	STACK_BRANCHES=()
	STACK_PARENTS=()
	STACK_TITLES=()
	# Parallel to STACK_BRANCHES: how many commits each has on top of the base.
	local -a heights=()
	local height j parent
	while read -r height i; do
		[[ -n "$height" ]] || continue
		branch="${branches[$i]}"
		# The nearest listed ancestor is the highest one, so the entries
		# recorded so far are tried from the top down and the first ancestor
		# found is the parent. An entry the same height up cannot be one.
		parent="$base"
		for ((j = ${#STACK_BRANCHES[@]} - 1; j >= 0; j--)); do
			[[ "${heights[$j]}" -lt "$height" ]] || continue
			if git merge-base --is-ancestor "refs/heads/${STACK_BRANCHES[$j]}" "refs/heads/$branch"; then
				parent="${STACK_BRANCHES[$j]}"
				break
			fi
		done
		STACK_BRANCHES+=("$branch")
		STACK_PARENTS+=("$parent")
		STACK_TITLES+=("$(git log -1 --format=%s "refs/heads/$branch")")
		heights+=("$height")
	done < <(printf '%s' "$order" | sort -n -k1,1 -k2,2)
}

# stack_index_of <branch>
#
# Prints the index of <branch> in the loaded stack; fails when it is absent.
stack_index_of() {
	local branch="$1" i
	for i in "${!STACK_BRANCHES[@]}"; do
		if [[ "${STACK_BRANCHES[$i]}" == "$branch" ]]; then
			printf '%s' "$i"
			return 0
		fi
	done
	return 1
}

# ---------------------------------------------------------------------------
# Output files
# ---------------------------------------------------------------------------

# The directory names and the verdict file come from lib/review.sh: this tool
# writes that tree and the merge gate reads it, so the layout is shared rather
# than agreed by hand. The run files below are this tool's own business — the
# gate only ever looks at the verdict.

# One directory per branch, fixed file names inside it: the branch is already
# identified by the directory, so nothing downstream has to take a file name
# apart to find out what it is looking at.
REVIEW_ROOT=""
REVIEW_LATEST=""
REVIEW_DIR=""
REVIEW_RANGE=""
REVIEW_OUTPUT=""
REVIEW_DEBUG=""
REVIEW_MD=""
REVIEW_VERDICT=""
REVIEW_SESSION=""

# set_run_files <run-dir>
#
# Points the file globals at one run directory.
set_run_files() {
	REVIEW_DIR="$1"
	REVIEW_RANGE="$REVIEW_DIR/range"
	REVIEW_OUTPUT="$REVIEW_DIR/output.jsonl"
	REVIEW_DEBUG="$REVIEW_DIR/debug.log"
	REVIEW_MD="$REVIEW_DIR/review.md"
	REVIEW_VERDICT="$REVIEW_DIR/verdict"
	REVIEW_SESSION="$REVIEW_DIR/session-id"
}

# set_review_paths <output-dir> <branch>
#
# Points everything at the branch's *most recent* run, which is what reading
# code (skip checks, status) wants. Writing code calls plan_run_dir afterwards
# to move onto a fresh one.
set_review_paths() {
	local dir="$1" branch="$2"
	# walks/ is the trains' own directory beside the per-branch ones.
	[[ "$(review_slug "$branch")" != "walks" ]] ||
		die "branch \"$branch\" cannot be reviewed: its review directory would be $dir/walks, where the walk records live"
	REVIEW_ROOT="$(review_root "$dir" "$branch")"
	REVIEW_LATEST="$(review_latest_dir "$dir" "$branch")"
	set_run_files "$REVIEW_LATEST"
}

# write_range_file <base> <branch>
#
# Records what the run covers (see the header): the base ref with the commit
# it stood at, then the commits under review, oldest first. The branch's
# contents are free to change between runs, so this is what later says which
# change a given run was about.
write_range_file() {
	local base="$1" branch="$2"
	{
		printf 'base: %s @ %s\n' "$base" "$(git rev-parse --verify "$base^{commit}")"
		git log --reverse --format='%H  %s' "$base..$branch"
	} >"$REVIEW_RANGE"
}

# plan_run_dir <create>
#
# Picks the next run directory — 001, 002, … under the branch's directory —
# and points the file globals at it. With <create> set it also makes the
# directory and moves the "latest" symlink onto it; with <create> zero it only
# works out the name, so a dry run can show where output would go without
# leaving an empty directory behind.
#
# The symlink is moved when the run *starts*, not when it finishes, so
# latest/output.jsonl can be tailed while the review is still thinking. A run
# that dies leaves latest pointing at its wreckage, which is the right place to
# look anyway; the verdict file, not the symlink, is what says a review
# succeeded.
plan_run_dir() {
	local create="$1" n=1 entry num dir
	for entry in "$REVIEW_ROOT"/[0-9][0-9][0-9]; do
		# Without nullglob an unmatched glob arrives literally; -d rejects it.
		[[ -d "$entry" ]] || continue
		num=$((10#${entry##*/}))
		[[ "$num" -ge "$n" ]] && n=$((num + 1))
	done
	dir="$(printf '%s/%03d' "$REVIEW_ROOT" "$n")"
	set_run_files "$dir"

	[[ "$create" -eq 1 ]] || return 0
	mkdir -p "$dir"
	# Relative target, so the whole tree can be moved or copied elsewhere.
	ln -sfn "$(basename "$dir")" "$REVIEW_LATEST"
}

# new_session_id
#
# A UUID for `claude --session-id`. The id is chosen here, before the run
# starts, rather than read back from the transcript afterwards, so the run
# directory says which session is its own from its first moment. An id on
# file is therefore not a session that exists: claude may be stopped before
# it has opened one (see run_session_started).
new_session_id() {
	if [[ -r /proc/sys/kernel/random/uuid ]]; then
		cat /proc/sys/kernel/random/uuid
	elif command -v uuidgen >/dev/null 2>&1; then
		uuidgen | tr '[:upper:]' '[:lower:]'
	else
		die "no way to generate a UUID (need /proc/sys/kernel/random/uuid or uuidgen)"
	fi
}

# run_session_started <run-dir>
#
# True when the run's Claude Code session came into being: the run has a
# session id, and its transcript holds the system/init event claude emits as
# it opens a session.
#
# The id alone does not say so. It is written before claude starts, and a run
# stopped while claude was still starting up — a Ctrl-C in the first second —
# leaves the id on file with no session behind it. `claude --resume` on such
# an id fails with "No conversation found", which would turn a stop into a
# failed review: under --keep-going the train would record it as failed and
# never come back to it.
run_session_started() {
	local dir="$1"
	[[ -s "$dir/session-id" && -f "$dir/output.jsonl" ]] || return 1
	grep -q -F '"subtype":"init"' "$dir/output.jsonl"
}

# find_resumable_run
#
# Points the file globals at the branch's newest run when that run was cut
# short and can be picked up again: its session had begun (see
# run_session_started), and it never reached a verdict. Returns nonzero when
# there is nothing to resume, leaving the globals where set_review_paths left
# them.
#
# An interrupted run is exactly the one worth continuing rather than repeating:
# the transcript holds however far the review got, and Claude Code keeps the
# session, so resuming carries the reasoning over instead of paying for it
# twice. A finished run is never resumable — it has its verdict, and asking for
# another opinion is a new run. Neither is a run stopped before its session
# began: there is no reasoning to carry over, and the review starts again as a
# fresh numbered run beside it.
find_resumable_run() {
	[[ -L "$REVIEW_LATEST" || -d "$REVIEW_LATEST" ]] || return 1
	local candidate="$REVIEW_LATEST"
	run_session_started "$candidate" || return 1
	local verdict
	verdict="$(read_verdict "$candidate/verdict")"
	[[ "$verdict" != "true" && "$verdict" != "false" ]] || return 1
	set_run_files "$candidate"
	return 0
}

# count_runs
#
# How many runs a branch has accumulated, for reporting.
count_runs() {
	local entry n=0
	for entry in "$REVIEW_ROOT"/[0-9][0-9][0-9]; do
		[[ -d "$entry" ]] || continue
		n=$((n + 1))
	done
	printf '%s' "$n"
}

# review_is_done <verdict-file>
#
# True only for a verdict that actually decided something. A missing file is a
# branch never reviewed; a malformed one is a run that went wrong, and either
# way there is work left to do — so neither counts as done and neither is
# skipped.
review_is_done() {
	local verdict
	verdict="$(read_verdict "$1")"
	[[ "$verdict" == "true" || "$verdict" == "false" ]]
}

# ---------------------------------------------------------------------------
# Walks (review-all --progress-track)
#
# The train's own record of what it has passed, kept beside the per-branch
# directories as <output-dir>/walks/<name>. The header comment of this file
# says what a walk is for and how a re-run reads it; this section is the file
# itself: one header, one line per entry reached, rewritten whole at every
# state change.
# ---------------------------------------------------------------------------

WALK_NAME=""
WALK_FILE=""
# The file's comment lines, kept verbatim across rewrites so the walk remembers
# which remap file it runs over and when it started.
WALK_HEADER=""
# Parallel arrays, in the order the train reached the entries.
WALK_STATES=()
WALK_BRANCHES=()

# load_walk <output-dir> <remap-file>
#
# Points WALK_FILE at the walk and reads it when it is there. A walk that was
# started over another remap file is refused: a walk is one train over one
# remap file, and continuing it over a different one would skip entries on the
# strength of a record that was never about them. "Another" means another
# file: the remap file is recorded and compared by its resolved path, since
# the same file is reached through a notes symlink from one worktree and
# directly from the next, and both are one file.
#
# A walk recorded before reviews were filed per branch has "#<pr-number>" in
# its lines and a "# plan:" header; it is refused on its first entry line. It
# was a train over a merge plan, which this script no longer reads.
load_walk() {
	local dir="$1" remap_file="$2" remap
	remap="$(resolve_self "$remap_file")"
	WALK_FILE="$dir/walks/$WALK_NAME"
	WALK_STATES=()
	WALK_BRANCHES=()
	if [[ ! -f "$WALK_FILE" ]]; then
		WALK_HEADER="$(printf '# review-all walk "%s"\n# remap file: %s\n# started: %s\n# <state>  <branch> — running, true, false or failed' \
			"$WALK_NAME" "$remap" "$(date -u '+%Y-%m-%d %H:%M:%SZ')")"
		return 0
	fi
	WALK_HEADER=""
	local line body state branch extra lineno=0 nl=$'\n' recorded_remap=""
	while IFS= read -r line || [[ -n "$line" ]]; do
		lineno=$((lineno + 1))
		body="${line#"${line%%[![:space:]]*}"}" # ltrim
		[[ -n "$body" ]] || continue
		if [[ "$body" == \#* ]]; then
			WALK_HEADER+="${WALK_HEADER:+$nl}$line"
			[[ "$body" != "# remap file: "* ]] || recorded_remap="${body#\# remap file: }"
			continue
		fi
		read -r state branch extra <<<"$body"
		case "$state" in
		running | true | false | failed) ;;
		*) die "$WALK_FILE:$lineno: unknown walk state \"$state\" (expected running, true, false or failed)" ;;
		esac
		[[ -n "$branch" && "$branch" != \#* && -z "$extra" ]] ||
			die "$WALK_FILE:$lineno: expected \"<state>  <branch>\" (a walk recorded per PR number cannot be continued: start one under another name)"
		WALK_STATES+=("$state")
		WALK_BRANCHES+=("$branch")
	done <"$WALK_FILE"
	[[ -z "$recorded_remap" || "$recorded_remap" == "$remap" ]] ||
		die "walk \"$WALK_NAME\" was started over $recorded_remap, not $remap: pass that remap file, or pick another name"
}

# walk_state_of <branch>
#
# The entry's recorded state, or nothing when the walk has not reached it.
walk_state_of() {
	local branch="$1" i
	for i in "${!WALK_BRANCHES[@]}"; do
		if [[ "${WALK_BRANCHES[$i]}" == "$branch" ]]; then
			printf '%s' "${WALK_STATES[$i]}"
			return 0
		fi
	done
	return 0
}

# walk_passed_count
#
# How many entries the walk has concluded — everything recorded but the one
# it may still be on.
walk_passed_count() {
	local state n=0
	for state in "${WALK_STATES[@]}"; do
		[[ "$state" == "running" ]] || n=$((n + 1))
	done
	printf '%s' "$n"
}

# walk_record <state> <branch>
#
# Sets the entry's state — appending the entry when the walk reaches it for
# the first time — and writes the file whole. The write goes through a rename,
# so a stop that lands mid-write leaves the previous record rather than a
# truncated one.
walk_record() {
	local state="$1" branch="$2" i found=0
	for i in "${!WALK_BRANCHES[@]}"; do
		if [[ "${WALK_BRANCHES[$i]}" == "$branch" ]]; then
			WALK_STATES[i]="$state"
			found=1
			break
		fi
	done
	if [[ "$found" -eq 0 ]]; then
		WALK_STATES+=("$state")
		WALK_BRANCHES+=("$branch")
	fi
	mkdir -p "$(dirname "$WALK_FILE")"
	{
		printf '%s\n' "$WALK_HEADER"
		for i in "${!WALK_STATES[@]}"; do
			printf '%-8s %s\n' "${WALK_STATES[$i]}" "${WALK_BRANCHES[$i]}"
		done
	} >"$WALK_FILE.tmp"
	mv -f "$WALK_FILE.tmp" "$WALK_FILE"
}

# ---------------------------------------------------------------------------
# Worktree ownership
# ---------------------------------------------------------------------------

ORIG_BRANCH=""
RESTORE_BRANCH=1
restore_branch() {
	[[ "$RESTORE_BRANCH" -eq 1 && -n "$ORIG_BRANCH" ]] || return 0
	local now
	now="$(git symbolic-ref --short -q HEAD || true)"
	[[ "$now" != "$ORIG_BRANCH" ]] || return 0
	printf '\n'
	if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
		# Somebody's uncommitted work is sitting here — a review that edited
		# tracked files, most likely. Carrying it onto another branch would
		# only spread the mess; say where things stand and leave it alone.
		printf 'not restoring %s: %s has modified tracked files\n' "$ORIG_BRANCH" "$now" >&2
		return 0
	fi
	note "restoring $ORIG_BRANCH"
	git checkout --quiet "$ORIG_BRANCH" ||
		printf 'warning: could not restore branch %s (you are on %s)\n' "$ORIG_BRANCH" "$now" >&2
}

# claim_worktree
#
# Refuses to run unless the worktree is ours to move around: tracked files must
# be clean. Untracked files are deliberately allowed — the default output
# directory sits inside the repo.
claim_worktree() {
	git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
	[[ -z "$(git status --porcelain --untracked-files=no)" ]] ||
		die "worktree has modified tracked files — this script checks branches out; commit, stash, or run it in another worktree"
	ORIG_BRANCH="$(git symbolic-ref --short -q HEAD)" ||
		die "detached HEAD — check out a branch first, so there is something to come back to"
	trap restore_branch EXIT
	trap_interrupts
}

# ---------------------------------------------------------------------------
# Interruption
# ---------------------------------------------------------------------------

# Name of the signal that interrupted the run; empty while nothing has.
INTERRUPTED=""
# 1 while a review's claude pipeline is running, 0 otherwise. Bash holds a
# trap until the foreground command has completed, so the handler never runs
# mid-pipeline; the flag tells it, once it does run, whether the signal landed
# during a review — whose outcome run_review must now judge — or between two,
# where there is nothing to judge and stopping is the whole job.
CLAUDE_RUNNING=0

# on_interrupt <signal-name>
#
# Ctrl-C reaches every process in the terminal's foreground group at once:
# this script, claude, tee and the formatter. claude catches SIGINT, shuts
# down and exits normally — and bash, seeing a child exit normally after a
# SIGINT, takes the signal as handled and carries on with the script. Left
# untrapped, an interrupt is therefore indistinguishable from a review that
# failed, and under --keep-going the train simply starts the next branch. The
# trap records the signal as a fact instead, for run_review and the train loop
# to act on as soon as the child has finished.
on_interrupt() {
	INTERRUPTED="$1"
	[[ "$CLAUDE_RUNNING" -eq 0 ]] || return 0
	# Between reviews there is no claude to wait for and nothing to judge.
	# The EXIT trap still restores the branch on the way out.
	printf '\n%sInterrupted (%s).%s\n' "$BOLD" "$INTERRUPTED" "$RESET" >&2
	exit "$(interrupt_status)"
}

# interrupt_status
#
# 128 + the recorded signal's number: the status a caller would have seen had
# the script died of the signal untrapped.
interrupt_status() {
	printf '%d' "$((128 + $(kill -l "$INTERRUPTED")))"
}

trap_interrupts() {
	local sig
	for sig in INT TERM HUP; do
		# shellcheck disable=SC2064  # the name is meant to expand now
		trap "on_interrupt $sig" "$sig"
	done
}

# assert_worktree_undisturbed <branch>
#
# A review is supposed to read the code and write its two files, both of which
# live outside version control. If it edited a tracked file instead, the next
# checkout in the train fails and every review after this one is against a
# worktree nobody intended — so stop here, while the damage is still one
# branch wide and obvious.
assert_worktree_undisturbed() {
	local branch="$1" dirty
	dirty="$(git status --porcelain --untracked-files=no)"
	[[ -n "$dirty" ]] || return 0
	printf 'error: the review of %s modified tracked files:\n%s\n' "$branch" "$dirty" >&2
	printf 'the worktree is left as-is for you to inspect; nothing further is reviewed\n' >&2
	return 1
}

# ---------------------------------------------------------------------------
# Prompt rendering and the review itself
# ---------------------------------------------------------------------------

# render_prompt <template> <branch> <base> <title> <repo-root> <review-file> <verdict-file>
render_prompt() {
	local template="$1" branch="$2" base="$3" title="$4" root="$5" review="$6" verdict="$7"
	[[ -f "$template" ]] || die "prompt template not found: $template"
	local text
	text="$(<"$template")"
	text="${text//\{\{BRANCH\}\}/$branch}"
	text="${text//\{\{BASE\}\}/$base}"
	text="${text//\{\{RANGE\}\}/$base..$branch}"
	text="${text//\{\{TITLE\}\}/$title}"
	text="${text//\{\{REPO_ROOT\}\}/$root}"
	text="${text//\{\{REVIEW_FILE\}\}/$review}"
	text="${text//\{\{VERDICT_FILE\}\}/$verdict}"
	printf '%s' "$text"
}

# session_name <branch> <base>
#
# The display label Claude Code shows for this run's session in the /resume
# picker and the terminal title:
#
#     review branch=mzg/2026-07-23/update-smoke-test base=mzg/2026-07-23/update-vm-cli run=001
#
# Every field is always present, in the same order, labelled. The base is
# there because a branch alone does not say what a run was about: the same
# branch reviewed after a reorder is a review against another parent.
session_name() {
	local branch="$1" base="$2"
	printf 'review branch=%s base=%s run=%s' "$branch" "$base" "$(basename "$REVIEW_DIR")"
}

# render_resume_prompt <review-file> <verdict-file>
#
# What a resumed session is told. Deliberately short: the session already
# carries the original prompt and whatever the review had worked out before it
# was cut off, so repeating the instructions would only invite a restart. All
# this has to do is point at the finish line again.
render_resume_prompt() {
	local review="$1" verdict="$2"
	cat <<EOF
Your previous session was interrupted before it finished. Continue the code
review from where it stopped — keep whatever you had already established rather
than starting over, and redo only what the interruption left unfinished.

Finish by writing both files, as originally instructed:

1. \`$review\` — the review.
2. \`$verdict\` — a single word, \`true\` or \`false\`, nothing else.
EOF
}

# Defaults for the claude invocation, overridable per run.
#
# The allowlist has to cover everything a review prompt legitimately does: read
# and search the tree (Bash, unrestricted — a review greps, finds and runs git
# however it likes), invoke the code-review skill (Skill), fan verification out
# to subagents (Task, plus TaskOutput/TaskStop to collect and cancel them, and
# ReportFindings for skills that report through it), reach deferred tool
# schemas (ToolSearch), and write its own two output files (Write, Edit). What
# it deliberately leaves out is the network: no WebFetch, no WebSearch, so a
# review is answered from this repository.
#
# The subagent tool answers to two names and both are listed, because which one
# the permission matcher keys on is not observable from the outside: the
# system/init event advertises it as "Task", while the tool_use blocks for the
# very same calls come back named "Agent". Listing both costs nothing and a
# wrong guess costs every verification subagent in the run.
#
# Do not read "no subagents ran" as "subagents were blocked" — a run with the
# wrong name allowlisted recorded zero denials, because the prompt of the day
# never asked for one. Denials show up in the result event's permission_denials
# array; an empty array with no Task/Agent calls means nothing was attempted.
#
# Erring narrow would be the worse mistake. An unattended `-p` run cannot
# answer a permission prompt, so a tool that is not pre-allowed is silently
# *denied* — and a review that was quietly refused the tools to look at the
# code still writes a confident verdict. The guard against a review disturbing
# the stack is assert_worktree_undisturbed after the run, not a narrow
# allowlist before it.
#
# Allowing Write is not enough on its own: claude also checks that the path
# being written lies inside one of its working directories, and it resolves
# symlinks before checking. A worktree whose .reviews is a symlink into another
# checkout — the usual arrangement, so every worktree shares one review tree —
# therefore has its two output files land *outside* the worktree as far as
# claude is concerned, and the writes are refused exactly like a tool that was
# never allowed. --add-dir with the output directory's physical path (see
# resolve_output_dir) is what grants them; the symlinked path does not work,
# because it is the resolved one that gets compared.
#
# ALLOWED_TOOLS is an array because tool specs contain spaces ("Bash(git *)").
ALLOWED_TOOLS=(
	Read Bash Write Edit
	Skill ReportFindings TodoWrite ToolSearch
	Task Agent TaskOutput TaskStop
)
TOOL_LIMITS=1
PERMISSION_MODE="acceptEdits"
# The model is always the caller's choice: there is no default, and the
# review commands refuse to run until --model has been given. MODEL_SET is what
# records that, since the empty string is itself a valid choice (see --model).
MODEL=""
MODEL_SET=0
EFFORT=""
TIMEOUT=0
DRY_RUN=0
# claude runs in a transient systemd user scope unless --no-systemd-scope
# (see "Systemd scope" in the header).
SYSTEMD_SCOPE=1

# format_stream
#
# Renders the stream-json transcript arriving on stdin as something worth
# watching — one line per tool call, the assistant's own prose, and the closing
# tally — while the JSON itself goes to output.jsonl untouched. Without jq
# there is nothing sensible to render, so the run goes quiet rather than
# dumping raw JSONL over the terminal.
#
# jq runs per line, not over the stream, for two reasons: one stray non-JSON
# line (a warning printed to stdout, say) would otherwise kill jq outright, and
# a dead jq means SIGPIPE upstream — killing the review it was only supposed to
# be narrating. For the same reason this function always succeeds: its exit
# status would otherwise become the pipeline's under `set -o pipefail` and be
# read as a failed review.
format_stream() {
	if ! command -v jq >/dev/null 2>&1; then
		cat >/dev/null
		return 0
	fi
	local line
	while IFS= read -r line; do
		printf '%s' "$line" | jq -r '
			if .type == "assistant" then
				(.message.content // [])[]
				| if .type == "tool_use" then
					"   -> \(.name): \((.input.description // .input.command // .input.file_path // .input.prompt // "") | tostring | .[0:110])"
				  elif .type == "text" and ((.text // "") | length) > 0 then
					"   \((.text | .[0:500]))"
				  else empty end
			elif .type == "result" then
				"   [\(.subtype // "done")] \(.num_turns // 0) turns, \((.duration_ms // 0) / 1000 | floor)s"
			else empty end
		' 2>/dev/null || true
	done
	return 0
}

# run_review <branch> <base> <title> <repo-root> <prompt-file> <resume>
#
# Checks the branch out, runs Claude, and validates that the two files the
# prompt asked for actually appeared. Returns nonzero on any of those failing;
# the caller decides whether that stops a train. <resume> (1 or 0) is whether
# to continue the branch's interrupted run when there is one: the flags decide
# that for a single review, and a walk decides it for the entry it was on.
run_review() {
	local branch="$1" base="$2" title="$3" root="$4" prompt_file="$5" resume="$6"

	git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null ||
		die "branch not found locally: $branch"
	git rev-parse --verify --quiet "$base^{commit}" >/dev/null ||
		die "base ref does not resolve: $base"
	# The review reads `git diff <base>..<branch>` as the change. That is the
	# change only when the branch sits on top of the base; otherwise it also
	# shows, reversed, everything the base has that the branch does not.
	git merge-base --is-ancestor "$base" "$branch" ||
		die "$base is not an ancestor of $branch: the branch has to sit on top of what it is reviewed against"

	# Every review is a fresh numbered run; earlier ones are never overwritten,
	# so a re-review can be compared against what it supersedes. The prompt has
	# to be rendered against this run's paths, hence the naming comes first.
	local previous
	previous="$(count_runs)"
	# Resuming reuses the interrupted run's directory and session; anything else
	# starts a numbered run of its own.
	local resuming=0
	if [[ "$resume" -eq 1 ]] && find_resumable_run; then
		resuming=1
	else
		# An undecided newest run that was to be resumed and cannot be: the
		# only way that happens is that its session never began.
		if [[ "$resume" -eq 1 && -s "$REVIEW_SESSION" ]] && ! review_is_done "$REVIEW_VERDICT"; then
			note "the run in $REVIEW_DIR/ was stopped before its session began: nothing to resume, starting a fresh run"
		fi
		plan_run_dir 0
	fi

	local prompt
	if [[ "$resuming" -eq 1 ]]; then
		prompt="$(render_resume_prompt "$REVIEW_MD" "$REVIEW_VERDICT")"
	else
		prompt="$(render_prompt "$prompt_file" "$branch" "$base" "$title" \
			"$root" "$REVIEW_MD" "$REVIEW_VERDICT")"
	fi

	local commits
	commits="$(git rev-list --count "$base..$branch")"
	[[ "$commits" -gt 0 ]] ||
		die "nothing to review: $branch has no commits on top of $base"
	note "range  $base..$branch ($commits commit(s))"
	if [[ "$resuming" -eq 1 ]]; then
		note "resume $REVIEW_DIR/ (session $(<"$REVIEW_SESSION"))"
	else
		local kept=""
		[[ "$previous" -gt 0 ]] && kept=" ($previous earlier run(s) kept)"
		note "output $REVIEW_DIR/$kept"
	fi

	if [[ "$DRY_RUN" -eq 1 ]]; then
		printf '\n--- prompt ---\n%s\n--- end prompt ---\n' "$prompt"
		return 0
	fi

	git checkout --quiet "$branch" || die "could not check out $branch"

	local session_id
	if [[ "$resuming" -eq 1 ]]; then
		session_id="$(<"$REVIEW_SESSION")"
	else
		plan_run_dir 1
		write_range_file "$base" "$branch"
		session_id="$(new_session_id)"
		printf '%s' "$session_id" >"$REVIEW_SESSION"
	fi

	# stream-json (which -p only allows with --verbose) is what makes
	# output.jsonl a real transcript rather than a closing summary: one event
	# per thinking block, tool call, tool result and final usage tally.
	local -a claude_cmd=(
		claude -p --output-format stream-json --verbose
		--permission-mode "$PERMISSION_MODE"
		--add-dir "$OUTPUT_DIR_PHYSICAL"
		--debug-file "$REVIEW_DEBUG"
	)
	# --session-id names the session so it can be found again; --resume picks
	# that same session up. Session persistence is what makes either work, so
	# --no-session-persistence must never be added here.
	#
	# A display name comes with it, because these sessions land in the same
	# /resume list as the interactive ones for this repo and a screenful of
	# untitled entries is a screenful you have to open to identify. It is set
	# only when the session is created: a resumed run is the same session and
	# keeps the name it was given.
	if [[ "$resuming" -eq 1 ]]; then
		claude_cmd+=(--resume "$session_id")
	else
		claude_cmd+=(--session-id "$session_id" --name "$(session_name "$branch" "$base")")
	fi
	[[ -n "$MODEL" ]] && claude_cmd+=(--model "$MODEL")
	[[ -n "$EFFORT" ]] && claude_cmd+=(--effort "$EFFORT")
	[[ "$TOOL_LIMITS" -eq 1 ]] && claude_cmd+=(--allowed-tools "${ALLOWED_TOOLS[@]}")
	local scope=""
	if [[ "$SYSTEMD_SCOPE" -eq 1 ]]; then
		# Innermost wrapper, around claude alone: systemd-run --scope enters
		# the unit and execs the command in place, so claude has the pid the
		# timeout below and the terminal signal, and the pipeline sees claude's
		# own exit status. stop_scope after the pipeline is the other half.
		scope="$(scope_unit_name)"
		claude_cmd=(systemd-run --user --scope --quiet --collect --unit="$scope" -- "${claude_cmd[@]}")
	fi
	if [[ "$TIMEOUT" -gt 0 ]]; then
		# --foreground keeps timeout in the terminal's process group. Without
		# it timeout moves into a group of its own, and neither it nor claude
		# ever hears the terminal's Ctrl-C: the script would sit through the
		# whole timeout, unable to stop. The cost is that on expiry only claude
		# itself is signalled, not the tools it has running; claude takes those
		# down as part of its own shutdown, and what that misses is the
		# scope's job.
		claude_cmd=(timeout --foreground --signal=INT "$TIMEOUT" "${claude_cmd[@]}")
	fi

	tick "running claude"
	local rc=0
	# Append on resume: the interrupted attempt's events stay, the continuation
	# follows them, and the file remains one transcript of how this run went.
	local -a capture=(tee "$REVIEW_OUTPUT")
	[[ "$resuming" -eq 1 ]] && capture=(tee -a "$REVIEW_OUTPUT")
	CLAUDE_RUNNING=1
	printf '%s' "$prompt" | "${claude_cmd[@]}" | "${capture[@]}" | format_stream || rc=$?
	# First thing after the pipeline, ahead of the interrupt handling, so an
	# interrupted review is reaped like any other.
	[[ -z "$scope" ]] || stop_scope "$scope"
	# An interrupt that cut the review short is not a failure: the run keeps
	# its session and no verdict, which is exactly what --resume looks for
	# (one that landed before the session began leaves nothing to resume, and
	# the next run starts fresh).
	# One that arrived as claude was writing its last file changed nothing —
	# the run decided, and is judged below like any other. The signal does end
	# tee and the formatter on the spot, so the pipeline's status says nothing
	# about claude's own, and the transcript of a cut-off run may stop a few
	# events short; the session itself is claude's, and is unaffected. Stages
	# that outlived the signal would instead wait for whatever still held
	# claude's stdout, and a stop that can hang is worse than a short
	# transcript.
	if [[ -n "$INTERRUPTED" ]]; then
		if ! review_is_done "$REVIEW_VERDICT"; then
			printf '\n%sInterrupted (%s) during %s.%s\n' "$BOLD" "$INTERRUPTED" "$branch" "$RESET" >&2
			if run_session_started "$REVIEW_DIR"; then
				note "run kept in $REVIEW_DIR/; --resume continues its session, --force starts a fresh run"
			else
				note "run kept in $REVIEW_DIR/; it was stopped before its session began, so the next run starts fresh"
			fi
			return "$(interrupt_status)"
		fi
		# The verdict is the completion marker; it, not a dead tee, says how
		# this run went. The files are still checked below like any other's.
		rc=0
	fi
	CLAUDE_RUNNING=0
	if [[ "$rc" -ne 0 ]]; then
		printf 'error: claude exited %s for %s (transcript in %s)\n' "$rc" "$branch" "$REVIEW_OUTPUT" >&2
		return 1
	fi

	assert_worktree_undisturbed "$branch" || return 1

	# The prompt owns these two files; if they are not here the review did not
	# happen, whatever the transcript says.
	[[ -s "$REVIEW_MD" ]] || {
		printf 'error: %s wrote no review to %s\n' "$branch" "$REVIEW_MD" >&2
		return 1
	}
	local verdict
	verdict="$(read_verdict "$REVIEW_VERDICT")"
	case "$verdict" in
	true | false) ;;
	"")
		printf 'error: %s wrote no verdict to %s\n' "$branch" "$REVIEW_VERDICT" >&2
		return 1
		;;
	*)
		printf 'error: %s wrote a malformed verdict to %s (expected "true" or "false")\n' \
			"$branch" "$REVIEW_VERDICT" >&2
		return 1
		;;
	esac

	tick "verdict: ready-to-merge = $verdict"
	return 0
}

# ---------------------------------------------------------------------------
# Shared option parsing
# ---------------------------------------------------------------------------

OUTPUT_DIR=""
# OUTPUT_DIR with symlinks resolved; set by resolve_output_dir. It exists for
# claude's --add-dir only (see the ALLOWED_TOOLS comment) — everything else,
# the prompt and the printed paths included, keeps using OUTPUT_DIR as given.
OUTPUT_DIR_PHYSICAL=""
PROMPT_FILE="$PROMPT_FILE_DEFAULT"
FORCE=0
RESUME=0
ALLOW_OVERRIDDEN=0
# Where the stack comes from (see "The stack"). BASE is what the bottom of the
# stack is reviewed against. STACK_HEAD is what --stack gave, for the remap
# check, and stays empty without it; NO_REMAP_CHECK is --no-remap-check.
REMAP_FILE=""
BASE="main"
STACK_HEAD=""
NO_REMAP_CHECK=0

# require_remap_check_choice
#
# With a remap file, exactly one of --stack and --no-remap-check: the check
# runs against a stack head that was passed, or it is switched off in so many
# words. There is no default to fall back on, on purpose. The only candidate
# is the branch checked out when the run starts, and that would make what is
# reviewed depend on where the run was started from: a train launched from a
# worktree parked on some other branch would be checked against that branch.
# Without a remap file there is nothing to check, so both flags are refused
# rather than ignored.
require_remap_check_choice() {
	[[ -z "$STACK_HEAD" || "$NO_REMAP_CHECK" -eq 0 ]] ||
		die "--stack and --no-remap-check contradict each other: --stack checks the remap file against that stack head, --no-remap-check skips the check"
	if [[ -z "$REMAP_FILE" ]]; then
		[[ -z "$STACK_HEAD" ]] ||
			die "--stack only applies with --remap-file: without one, the branch is reviewed against --base ($BASE) directly"
		[[ "$NO_REMAP_CHECK" -eq 0 ]] ||
			die "--no-remap-check only applies with --remap-file: without one, there is no remap file to check"
		return 0
	fi
	[[ -n "$STACK_HEAD" || "$NO_REMAP_CHECK" -eq 1 ]] ||
		die "a remap file needs its stack head: pass --stack <branch> — the branch the stack is built on, the one \`pr-stack remap\` is run against — so the listed branches are checked against it, or --no-remap-check to review them where they are"
}

# parse_common_opt <arg> [value...]
#
# Handles the options shared by review and review-all, setting OPT_CONSUMED to
# how many arguments it took (0 when it does not recognise the option). It
# reports through a global rather than stdout because it assigns to globals
# itself: called in a command substitution, every one of those assignments
# would be lost with the subshell.
OPT_CONSUMED=0
parse_common_opt() {
	OPT_CONSUMED=2
	case "$1" in
	-m | --remap-file)
		REMAP_FILE="${2:-}"
		[[ -n "$REMAP_FILE" ]] || die "$1 requires a value"
		;;
	--base)
		BASE="${2:-}"
		[[ -n "$BASE" ]] || die "--base requires a value"
		;;
	--stack)
		STACK_HEAD="${2:-}"
		[[ -n "$STACK_HEAD" ]] || die "--stack requires a value"
		;;
	--no-remap-check)
		NO_REMAP_CHECK=1
		OPT_CONSUMED=1
		;;
	--output-dir)
		OUTPUT_DIR="${2:-}"
		[[ -n "$OUTPUT_DIR" ]] || die "--output-dir requires a value"
		;;
	--prompt-file)
		PROMPT_FILE="${2:-}"
		[[ -n "$PROMPT_FILE" ]] || die "--prompt-file requires a value"
		;;
	--model)
		# Empty is meaningful here — it means "do not pass --model at all" —
		# so this checks that an argument is present, not that it is non-empty.
		[[ $# -ge 2 ]] || die "--model requires a value"
		MODEL="$2"
		MODEL_SET=1
		;;
	--effort)
		EFFORT="${2:-}"
		[[ -n "$EFFORT" ]] || die "--effort requires a value"
		;;
	--permission-mode)
		PERMISSION_MODE="${2:-}"
		[[ -n "$PERMISSION_MODE" ]] || die "--permission-mode requires a value"
		;;
	--allow)
		[[ -n "${2:-}" ]] || die "--allow requires a value"
		# First --allow replaces the defaults; the rest add to it.
		if [[ "$ALLOW_OVERRIDDEN" -eq 0 ]]; then
			ALLOWED_TOOLS=()
			ALLOW_OVERRIDDEN=1
		fi
		ALLOWED_TOOLS+=("$2")
		;;
	--timeout)
		TIMEOUT="${2:-}"
		[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "--timeout requires a number of seconds"
		;;
	--no-tool-limits)
		TOOL_LIMITS=0
		OPT_CONSUMED=1
		;;
	--systemd-scope)
		SYSTEMD_SCOPE=1
		OPT_CONSUMED=1
		;;
	--no-systemd-scope)
		SYSTEMD_SCOPE=0
		OPT_CONSUMED=1
		;;
	--force)
		FORCE=1
		OPT_CONSUMED=1
		;;
	--resume)
		RESUME=1
		OPT_CONSUMED=1
		;;
	--no-restore)
		RESTORE_BRANCH=0
		OPT_CONSUMED=1
		;;
	--dry-run)
		DRY_RUN=1
		OPT_CONSUMED=1
		;;
	-h | --help) usage 0 ;;
	*) OPT_CONSUMED=0 ;;
	esac
}

# resolve_output_dir <repo-root>
resolve_output_dir() {
	local root="$1"
	[[ -n "$OUTPUT_DIR" ]] || OUTPUT_DIR="$root/.reviews"
	mkdir -p "$OUTPUT_DIR"
	OUTPUT_DIR="$(cd "$OUTPUT_DIR" && pwd)"
	OUTPUT_DIR_PHYSICAL="$(cd "$OUTPUT_DIR" && pwd -P)"
}

# ---------------------------------------------------------------------------
# review
# ---------------------------------------------------------------------------

# cmd_review
#
# One branch, against its parent. Where the parent comes from is the only
# thing --remap-file changes: derived from the stack with it, taken from
# --base without it. Everything after that — the directory, the run files,
# the session, what the merge gate later reads — is the same review.
cmd_review() {
	local branch=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-*)
			parse_common_opt "$@"
			[[ "$OPT_CONSUMED" -gt 0 ]] || die "unknown option: $1"
			shift "$OPT_CONSUMED"
			;;
		*)
			[[ -z "$branch" ]] || die "unexpected argument: $1"
			branch="$1"
			shift
			;;
		esac
	done
	[[ -n "$branch" ]] || usage 1
	require_remap_check_choice

	require_tools
	require_model
	require_systemd_scope
	claim_worktree

	local base="$BASE" title idx
	if [[ -n "$REMAP_FILE" ]]; then
		load_stack "$REMAP_FILE" "$BASE" "$STACK_HEAD"
		idx="$(stack_index_of "$branch")" ||
			die "branch not listed in $REMAP_FILE: $branch"
		base="${STACK_PARENTS[$idx]}"
		title="${STACK_TITLES[$idx]}"
	else
		git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null ||
			die "branch not found locally: $branch"
		title="$(git log -1 --format=%s "refs/heads/$branch")"
	fi

	local root
	root="$(git rev-parse --show-toplevel)"
	resolve_output_dir "$root"
	set_review_paths "$OUTPUT_DIR" "$branch"

	if [[ "$FORCE" -eq 0 && "$DRY_RUN" -eq 0 ]] && review_is_done "$REVIEW_VERDICT"; then
		die "already reviewed: $REVIEW_VERDICT says $(read_verdict "$REVIEW_VERDICT") (--force to redo)"
	fi

	step "Reviewing $branch against $base"
	[[ -z "$title" ]] || note "$title"
	# --resume asks to continue an interrupted run; --force wins if both are given.
	local resume=0
	[[ "$RESUME" -eq 1 && "$FORCE" -eq 0 ]] && resume=1
	run_review "$branch" "$base" "$title" "$root" "$PROMPT_FILE" "$resume"
}

# ---------------------------------------------------------------------------
# review-all
# ---------------------------------------------------------------------------

cmd_review_all() {
	local max=0 keep_going=0 failed=0 no_walk=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--failed)
			failed=1
			shift
			;;
		--max)
			max="${2:-}"
			[[ "$max" =~ ^[0-9]+$ ]] || die "--max requires a number"
			shift 2
			;;
		--keep-going)
			keep_going=1
			shift
			;;
		--progress-track)
			WALK_NAME="${2:-}"
			[[ -n "$WALK_NAME" ]] || die "--progress-track requires a name"
			# The name is a file name under walks/: one path component, no
			# shell-hostile characters.
			[[ "$WALK_NAME" =~ ^[A-Za-z0-9._-]+$ ]] ||
				die "--progress-track: a name is letters, digits, '.', '_' and '-' only: $WALK_NAME"
			shift 2
			;;
		--no-progress-track)
			no_walk=1
			shift
			;;
		-*)
			parse_common_opt "$@"
			[[ "$OPT_CONSUMED" -gt 0 ]] || die "unknown option: $1"
			shift "$OPT_CONSUMED"
			;;
		*) die "unexpected argument: $1 (the remap file is passed with --remap-file)" ;;
		esac
	done
	[[ -n "$REMAP_FILE" ]] ||
		die "review-all needs the stack: pass --remap-file <file> (-m)"
	require_remap_check_choice
	# --force redoes decided entries regardless of what they decided; --failed
	# selects *by* the decision. Combining them is a contradiction, not a
	# stronger ask, and the honest spelling of "redo passed ones too" is
	# --force alone.
	[[ "$failed" -eq 0 || "$FORCE" -eq 0 ]] ||
		die "--failed and --force contradict each other: --failed re-reviews by verdict, --force regardless of it; to redo passed reviews too, drop --failed"
	# A train is a walk unless told otherwise. Verdicts alone cannot resume a
	# --force or --failed train (see "Walks" in the header), and a train that
	# forgot to name its walk finds that out only when it is stopped — too
	# late. So the walk is not optional: name it, or say in so many words that
	# this train runs without one. Both at once is a contradiction.
	[[ "$no_walk" -eq 0 || -z "$WALK_NAME" ]] ||
		die "--progress-track and --no-progress-track contradict each other: pick one"
	[[ "$no_walk" -eq 1 || -n "$WALK_NAME" ]] ||
		die "review-all needs a walk: pass --progress-track <name> so a stopped train can resume, or --no-progress-track to run without one"

	require_tools
	require_model
	require_systemd_scope
	claim_worktree
	local remap_file="$REMAP_FILE"
	load_stack "$remap_file" "$BASE" "$STACK_HEAD"

	local root
	root="$(git rev-parse --show-toplevel)"
	resolve_output_dir "$root"
	[[ -z "$WALK_NAME" ]] || load_walk "$OUTPUT_DIR" "$remap_file"

	local -a todo_idx=()
	local i walk_state
	for i in "${!STACK_BRANCHES[@]}"; do
		set_review_paths "$OUTPUT_DIR" "${STACK_BRANCHES[$i]}"
		# The walk speaks first: what it has passed is passed whatever it
		# decided, and the entry it was on is taken whatever the flags would
		# select — its run has no verdict yet, so --failed alone would drop it.
		walk_state=""
		[[ -z "$WALK_NAME" ]] || walk_state="$(walk_state_of "${STACK_BRANCHES[$i]}")"
		case "$walk_state" in
		true | false | failed) continue ;;
		running)
			# Unless that run decided after all: then the stop landed as the
			# verdict was being written, and all that is left is to record it.
			if review_is_done "$REVIEW_VERDICT"; then
				[[ "$DRY_RUN" -eq 1 ]] ||
					walk_record "$(read_verdict "$REVIEW_VERDICT")" "${STACK_BRANCHES[$i]}"
				continue
			fi
			todo_idx+=("$i")
			continue
			;;
		esac
		if [[ "$failed" -eq 1 ]]; then
			# Only a decided "false" is a rejection. Missing, malformed and
			# unfinished runs are pending, and pending is the ordinary
			# selection's to retry — picking them up here would blur "the
			# review said no" with "the review never happened".
			[[ "$(read_verdict "$REVIEW_VERDICT")" == "false" ]] || continue
		elif [[ "$FORCE" -eq 0 ]] && review_is_done "$REVIEW_VERDICT"; then
			continue
		fi
		todo_idx+=("$i")
	done

	if [[ ${#todo_idx[@]} -eq 0 ]]; then
		if [[ -n "$WALK_NAME" ]]; then
			printf '%sNothing left in walk "%s".%s It has passed %d entry(ies) of %s; a new walk is a new name.\n' \
				"$BOLD" "$WALK_NAME" "$RESET" "$(walk_passed_count)" "$remap_file"
		elif [[ "$failed" -eq 1 ]]; then
			printf '%sNothing to re-review.%s No entry in %s has a latest verdict of "false".\n' \
				"$BOLD" "$RESET" "$remap_file"
		else
			printf '%sNothing to review.%s Every entry in %s already has a verdict.\n' \
				"$BOLD" "$RESET" "$remap_file"
		fi
		return 0
	fi

	local doing="review"
	[[ "$failed" -eq 1 ]] && doing="re-review"
	printf '%s%d branch(es) to %s from %s.%s\n' "$BOLD" "${#todo_idx[@]}" "$doing" "$remap_file" "$RESET"
	[[ -z "$WALK_NAME" ]] ||
		note "walk \"$WALK_NAME\": $(walk_passed_count) entry(ies) passed before this run, recorded in $WALK_FILE"

	local done_count=0 failed_count=0 idx branch base title verdict review_rc resume_this
	local -a summary=()
	for idx in "${todo_idx[@]}"; do
		if [[ "$max" -gt 0 && "$done_count" -ge "$max" ]]; then
			printf '\n%sStopping after %d review(s)%s (--max); %d left in the stack, re-run to continue.\n' \
				"$BOLD" "$done_count" "$RESET" "$((${#todo_idx[@]} - done_count))"
			break
		fi

		branch="${STACK_BRANCHES[$idx]}"
		title="${STACK_TITLES[$idx]}"
		base="${STACK_PARENTS[$idx]}"
		set_review_paths "$OUTPUT_DIR" "$branch"

		step "Reviewing $branch against $base ($((done_count + 1))/${#todo_idx[@]})"
		[[ -n "$title" ]] && note "$title"

		# --resume asks to continue an interrupted run, and --force wins over
		# it — except for the entry a walk was on: the walk is what asks for
		# that one, and --force speaks for the entries it has not reached.
		resume_this=0
		[[ "$RESUME" -eq 1 && "$FORCE" -eq 0 ]] && resume_this=1
		if [[ -n "$WALK_NAME" ]]; then
			[[ "$(walk_state_of "$branch")" != "running" ]] || resume_this=1
			[[ "$DRY_RUN" -eq 1 ]] || walk_record running "$branch"
		fi

		review_rc=0
		run_review "$branch" "$base" "$title" "$root" "$PROMPT_FILE" "$resume_this" || review_rc=$?
		if [[ "$review_rc" -eq 0 ]]; then
			verdict="$(read_verdict "$REVIEW_VERDICT")"
			summary+=("$(printf '%-7s %s' "${verdict:-dry-run}" "$branch")")
			[[ -z "$WALK_NAME" || "$DRY_RUN" -eq 1 ]] || walk_record "$verdict" "$branch"
		elif [[ -n "$INTERRUPTED" ]]; then
			# Cut short, not failed: the run is there to be resumed, and the
			# walk keeps the entry as "running" for the same reason.
			summary+=("$(printf '%-7s %s' "paused" "$branch")")
		else
			failed_count=$((failed_count + 1))
			summary+=("$(printf '%-7s %s' "FAILED" "$branch")")
			if [[ "$keep_going" -eq 0 ]]; then
				# The train stops here, so this is where the walk stays: the
				# entry is left "running" and the re-run retries it.
				printf '\n%sStopped at %s.%s Re-run to resume; --keep-going to push through failures.\n' \
					"$BOLD" "$branch" "$RESET" >&2
				print_summary "${summary[@]}"
				return 1
			fi
			# Moving past a failure is passing it: the walk records it as such
			# and the re-run does not come back to it.
			[[ -z "$WALK_NAME" ]] || walk_record failed "$branch"
		fi
		# An interrupt ends the train whatever --keep-going says: that flag is
		# about failures, and being asked to stop is not one. The review that
		# was running has either been recorded above or is waiting for --resume.
		if [[ -n "$INTERRUPTED" ]]; then
			printf '\n%sInterrupted at %s.%s Re-run to continue the train.\n' \
				"$BOLD" "$branch" "$RESET" >&2
			print_summary "${summary[@]}"
			return "$(interrupt_status)"
		fi
		done_count=$((done_count + 1))
	done

	print_summary "${summary[@]}"
	[[ "$failed_count" -eq 0 ]] || return 1
	return 0
}

print_summary() {
	[[ $# -gt 0 ]] || return 0
	printf '\n%sSummary%s (ready-to-merge)\n' "$BOLD" "$RESET"
	local line
	for line in "$@"; do
		printf '   %s\n' "$line"
	done
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-m | --remap-file)
			REMAP_FILE="${2:-}"
			[[ -n "$REMAP_FILE" ]] || die "$1 requires a value"
			shift 2
			;;
		--output-dir)
			OUTPUT_DIR="${2:-}"
			[[ -n "$OUTPUT_DIR" ]] || die "--output-dir requires a value"
			shift 2
			;;
		-h | --help) usage 0 ;;
		-*) die "unknown option: $1" ;;
		*) die "unexpected argument: $1 (the remap file is passed with --remap-file)" ;;
		esac
	done
	[[ -n "$REMAP_FILE" ]] ||
		die "status needs the stack: pass --remap-file <file> (-m)"

	# The file's own order, and no matching against commits: status reports
	# what the review tree holds for each listed branch, which does not depend
	# on where the branches sit.
	parse_remap_file "$REMAP_FILE"

	local root
	root="$(git rev-parse --show-toplevel)" || die "not inside a git repository"
	[[ -n "$OUTPUT_DIR" ]] || OUTPUT_DIR="$root/.reviews"

	printf 'Remap file %s (reviews in %s)\n\n' "$REMAP_FILE" "$OUTPUT_DIR"
	local i state verdict runs pending=0
	local -A seen=()
	for i in "${!REMAP_BRANCHES[@]}"; do
		# A branch listed twice is one entry, as in load_stack.
		[[ -z "${seen[${REMAP_BRANCHES[$i]}]:-}" ]] || continue
		seen["${REMAP_BRANCHES[$i]}"]=1
		set_review_paths "$OUTPUT_DIR" "${REMAP_BRANCHES[$i]}"
		verdict="$(read_verdict "$REVIEW_VERDICT")"
		runs="$(count_runs)"
		if review_is_done "$REVIEW_VERDICT"; then
			state="$verdict"
		elif run_session_started "$REVIEW_LATEST"; then
			# Started and never finished: --resume can pick this one up.
			state="resumable"
			pending=$((pending + 1))
		else
			# Missing, malformed, and stopped before its session began alike:
			# review-all will pick it up again.
			state="${verdict:-pending}"
			pending=$((pending + 1))
		fi
		printf '  %-9s %-9s %s\n' "$state" \
			"$([[ "$runs" -gt 0 ]] && printf '%s run(s)' "$runs" || printf '')" \
			"${REMAP_BRANCHES[$i]}"
	done
	printf '\n%d entry(ies) still pending review.\n' "$pending"
}

[[ $# -gt 0 ]] || usage 1
command="$1"
shift
case "$command" in
review) cmd_review "$@" ;;
review-all) cmd_review_all "$@" ;;
status) cmd_status "$@" ;;
-h | --help) usage 0 ;;
*) die "unknown command: $command (expected 'review', 'review-all', or 'status')" ;;
esac
